# ---- Obligatorio ----
DOMAIN=taller.ejemplo.ca
PUBLIC_URL=https://taller.ejemplo.ca
POSTGRES_PASSWORD=cambia-esta-clave-larga

# ---- Fotos y PDF: local en el servidor (por defecto) o S3 Montreal ----
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=tallerpro-fotos
# S3_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ---- SMS y WhatsApp (Twilio). Sin esto, los mensajes solo se registran (no se envían). ----
SMS_PROVIDER=log
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+14385550000
# TWILIO_WHATSAPP_FROM=+14385550000

# ---- Correo: Gmail gratis (hasta ~500 al día) o Amazon SES ----
# Gmail: activa la verificación en 2 pasos y crea una «contraseña de aplicación» (16 letras, sin espacios).
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://tucorreo%40gmail.com:CONTRASENADEAPLICACION@smtp.gmail.com:465
# EMAIL_FROM=Mécanique El Cabo <tucorreo@gmail.com>
#
# Amazon SES:
EMAIL_PROVIDER=log
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://USUARIO_SMTP:CLAVE_SMTP@email-smtp.ca-central-1.amazonaws.com:465
# EMAIL_FROM=Mécanique El Cabo <no-reply@taller.ejemplo.ca>

# ---- Opcional ----
SESSION_IDLE_HOURS=8
PORTAL_LINK_DAYS=7
